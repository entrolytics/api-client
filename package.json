{
  "name": "@entrolytics/api-client",
  "version": "3.0.0",
  "description": "TypeScript API client for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "api",
    "client",
    "entrolytics",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/api-client.git",
    "directory": "packages/api"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "lint": "vp lint --fix . && vp fmt --write .",
    "lint:check": "vp lint . && vp fmt --check .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "format": "vp fmt --write .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "next",
    "vite": "^8.2.2",
    "vite-plus": "^0.3.1"
  },
  "packageManager": "pnpm@11.26.0"
}
